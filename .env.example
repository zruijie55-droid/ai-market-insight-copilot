# ===== 大模型增强（可选）=====
# 本项目 V1.1 无需任何 Key 即可完成数据清洗/竞品分析/规则洞察。
# 仅当希望启用「大模型增强」（情感/主题/假设描述由模型辅助生成）时，才需要配置以下项。
# 配置后，在应用侧边栏勾选「启用大模型增强」即可生效。
#
# ⚠️ 安全：本文件名为 .env.example，提交到 GitHub 的是它（不含真实密钥）。
#    真实密钥请写入 .env（已被 .gitignore 排除），切勿提交 .env 或把密钥写进源代码。

# OpenAI 或兼容网关的 API Key（如本地 Ollama 走兼容接口也可用）
OPENAI_API_KEY=your-api-key-here

# 兼容接口地址；留空则使用 OpenAI 官方地址。本地模型（如 Ollama）可填：
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=

# 模型名；留空默认 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
